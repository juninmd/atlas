{
  "name": "atlas",
  "version": "2.0.0",
  "description": "Atlas: catálogo e raio-X dos seus repositórios do GitHub, 100% no navegador",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pwa.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "topics:plan": "node scripts/topics.ts",
    "topics:apply": "node scripts/topics.ts --apply",
    "topics:verify": "node scripts/topics.ts --verify",
    "stack:collect": "node scripts/stack-cli.ts collect",
    "stack:who": "node scripts/stack-cli.ts who",
    "stack:report": "node scripts/stack-cli.ts report",
    "mcp": "node scripts/mcp.ts",
    "test": "node --test scripts/*.test.ts src/core/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.18"
  }
}
